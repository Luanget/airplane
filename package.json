{
  "name": "airplane-pwa",
  "version": "0.9.22",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:worker": "node tests/runtime.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:health-actions-ui": "node tests/health-actions-browser.mjs",
    "test:model-agent-ui": "node tests/model-agent-browser.mjs",
    "test:model-agent-live": "node tests/model-agent-live.mjs",
    "test:agent-live": "node tests/agent-live.mjs",
    "test:agent-eval": "node tests/agent-eval.mjs",
    "test:medical-ui": "node tests/medical-browser.mjs",
    "test:inventory-ui": "node tests/package-browser.mjs",
    "dev:api": "wrangler dev --local --config worker/wrangler.toml --port 8787",
    "test:owner-ui": "node tests/owner-browser.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261118.0-beta",
    "playwright-core": "1.57.0",
    "wrangler": "4.165.0"
  }
}
